import sys
if (len(sys.argv) < 2):
    print("Укажите путь к файлу") 
    sys.exit(1)
try:
    with open(sys.argv[1], "r", encoding="utf-8") as file:
        text = file.read()
except FileNotFoundError:
    print("Файл не найден.")
    sys.exit(1)
if not text.strip():
    print("Файл пустой.")
    sys.exit(1)

