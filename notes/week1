def get_even_and_odd_teams(players):
    evenlist = []
    oddlist = []
    for i in range(0, len(players), 1):
        if i % 2 == 0:
            evenlist.append(players[i])
        else:
            oddlist.append(players[i])
    return evenlist, oddlist
    
