#task1 binary_search
def linear_search(numbers, target):
    for index, number in enumerate(numbers):
        if number == target:
            return index
    return -1 #O(n)

def binary_search(numbers, target): #O(logn)
    left = 0
    right = len(numbers) - 1

    while left <= right:
        mid = (left + right) // 2

        if numbers[mid] == target:
            return mid
        
        if numbers[mid] < target:
            left = mid + 1
        else:
            right = mid - 1

    return -1

assert binary_search([2, 4, 7, 10, 13], 10) == 3
result = binary_search([2, 4, 7, 10, 13], 10)
print(result)

#2 таск: сортировка слиянием

def merge_sort(numbers: list[int]) -> list[int]:
    if len(numbers) <= 1:
        return numbers.copy()

    mid = len(numbers) // 2
    left = merge_sort(numbers[:mid])
    right = merge_sort(numbers[mid:])
    merged = []
    i = 0
    j = 0

    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            merged.append(left[i])
            i += 1
        else:
            merged.append(right[j])
            j += 1
    merged.extend(left[i:])
    merged.extend(right[j:])
    return merged

assert merge_sort([5, 1, 4, 2]) == [1, 2, 4, 5]
result2 = merge_sort([5, 1, 4, 2]) 
print(result2)

#3 таск: проверка скобок

def brackets_are_balanced(text):
    pairs = {")": "(", "]": "[", "}": "{"}
    stack = []

    for char in text:
        if char in "([{":
            stack.append(char)
        elif char in pairs:
            if not stack:
                return False

            last_opening = stack.pop()
            if last_opening != pairs[char]:
                return False

    return not stack


assert brackets_are_balanced("([])")
assert not brackets_are_balanced("([)]")
assert not brackets_are_balanced(")")
assert not brackets_are_balanced("((")
assert brackets_are_balanced("")

